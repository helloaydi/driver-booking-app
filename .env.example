# Copy to .env for local development. Never commit .env.
PORT=4602
HOST=127.0.0.1
DB_PATH=./data/driverbooking.db
# From Google Cloud Console → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# 1 = show a "developer sign-in" box (any email, no Google). Ignored when NODE_ENV=production.
DEV_LOGIN=1
# Razorpay (Dashboard → Account & Settings → API Keys). Test keys start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook (Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=
